@model IEnumerable<KoopSatis.Models.Product.Product>
@{
    ViewData["Title"] = "Ürün Listesi";
}

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h2>@ViewData["Title"]</h2>
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Yeni Ürün
            </a>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="productsTable">
                    <thead>
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Name)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Barcode)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.SKU)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.PurchasePrice)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.SalePrice)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Category)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.TaxRate)
                            </th>
                            <th>
                                Durum
                            </th>
                            <th>
                                İşlemler
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Name)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Barcode)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.SKU)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.PurchasePrice) ₺
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.SalePrice) ₺
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Category.Name)
                                </td>
                                <td>
                                    @(item.TaxRate)%
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge text-bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">Pasif</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                            <i class="bi bi-info-circle"></i> Detay
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i> Düzenle
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i> Sil
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#productsTable').DataTable({
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.10.25/i18n/Turkish.json"
                }
            });
        });
    </script>
} 