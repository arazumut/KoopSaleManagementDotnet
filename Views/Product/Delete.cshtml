@model KoopSatis.Models.Product.Product

@{
    ViewData["Title"] = "Ürün Sil";
}

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-danger text-white">
            <h2>@ViewData["Title"]: @Model.Name</h2>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill"></i> Bu ürünü silmek istediğinizden emin misiniz?
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.Name)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Name)
                        </dd>

                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.Category)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Category.Name)
                        </dd>

                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.Barcode)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Barcode)
                        </dd>

                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.SKU)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.SKU)
                        </dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.PurchasePrice)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.PurchasePrice) ₺
                        </dd>

                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.SalePrice)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.SalePrice) ₺
                        </dd>

                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.TaxRate)
                        </dt>
                        <dd class="col-sm-8">
                            @(Model.TaxRate)%
                        </dd>

                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.IsActive)
                        </dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge text-bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge text-bg-danger">Pasif</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
            
            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Vazgeç
                </a>
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Sil
                </button>
            </form>
        </div>
    </div>
</div> 